# Local AI harness installs and runtime state
.omx/

# AI folders are mostly local installs. TALKPIK and Superpowers skills are
# authored once under .agents/ and host-specific mirrors are generated locally
# by scripts/sync-agent-skills.mjs.
.agents/*
!.agents/README.md
!.agents/skills/
.agents/skills/*
!.agents/skills/talkpik-*/
!.agents/skills/talkpik-*/SKILL.md

