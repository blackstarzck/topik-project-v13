# Local AI harness installs and runtime state
.omx/

# AI folders are mostly local installs. TALKPIK and Superpowers skills are
# authored once under .agents/ and host-specific mirrors are generated locally
# by scripts/sync-agent-skills.mjs.
.agents/*
!.agents/README.md
!.agents/skills/
.agents/skills/*
!.agents/skills/talkpik-*/
!.agents/skills/talkpik-*/SKILL.md

# Versioned practical skills shared by Codex and Claude. Keep full directories
# because some external skills include scripts, helpers, or reference files.
!.agents/skills/ant-design/
!.agents/skills/ant-design/**
!.agents/skills/deploy-to-vercel/
!.agents/skills/deploy-to-vercel/**
!.agents/skills/next-best-practices/
!.agents/skills/next-best-practices/**
!.agents/skills/next-cache-components/
!.agents/skills/next-cache-components/**
!.agents/skills/next-upgrade/
!.agents/skills/next-upgrade/**
!.agents/skills/playwright-skill/
!.agents/skills/playwright-skill/**
!.agents/skills/react-hook-form-zod/
!.agents/skills/react-hook-form-zod/**
!.agents/skills/supabase/
!.agents/skills/supabase/**
!.agents/skills/supabase-postgres-best-practices/
!.agents/skills/supabase-postgres-best-practices/**
!.agents/skills/vercel-cli-with-tokens/
!.agents/skills/vercel-cli-with-tokens/**
!.agents/skills/vercel-composition-patterns/
!.agents/skills/vercel-composition-patterns/**
!.agents/skills/vercel-react-best-practices/
!.agents/skills/vercel-react-best-practices/**
!.agents/skills/vercel-react-native-skills/
!.agents/skills/vercel-react-native-skills/**
!.agents/skills/vercel-react-view-transitions/
!.agents/skills/vercel-react-view-transitions/**
!.agents/skills/vitest-testing/
!.agents/skills/vitest-testing/**
!.agents/skills/web-design-guidelines/
!.agents/skills/web-design-guidelines/**

!.agents/superpowers/
.agents/superpowers/*
!.agents/superpowers/skills/
.agents/superpowers/skills/*
!.agents/superpowers/skills/*/
!.agents/superpowers/skills/*/SKILL.md
# Ignore local Claude config, but TRACK the shared project settings.json so the
# committed Stop hook (real-app smoke gate, scripts/hooks/require-ui-smoke.mjs)
# is enforced for everyone, not just one machine. settings.local.json (personal
# permissions / machine paths) stays ignored.
.claude/*
!.claude/settings.json
.codex/

# Local/generated analysis artifacts
harness-docs-analysis.html
workflow-evaluation.html

# Implementation Coverage Audit (Plan 20260523) — analysis-only artifacts.
# These paths hold secret/session/temp files during the audit execution; durable
# outputs are promoted to reports/ before commit. See:
#   docs/ai-workflow/plans/20260523-0100-implementation-coverage-audit.md (§4, §10 Task 0)
scripts/audit-setup/*
!scripts/audit-setup/
!scripts/audit-setup/*.mjs
tests/e2e/auth-state/
screenshots/
tests/e2e/coverage/failure-log.json
analysis/
.env.local.bak

# Dependencies and build outputs
node_modules/
dist/
build/
.next/
out/
coverage/
# The `coverage/` rule above is for test coverage output (NYC/Vitest). Our
# Playwright E2E specs happen to live under tests/e2e/coverage/ — unignore them.
!tests/e2e/coverage/
!tests/e2e/coverage/**

# Logs and caches
*.log
.cache/
.turbo/
.vite/
*.tsbuildinfo

# Environment, credentials, and local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
