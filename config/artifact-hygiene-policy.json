{
  "schemaVersion": 1,
  "kind": "ArtifactHygienePolicy",
  "rootAllowlist": [
    ".claude",
    ".codex",
    ".env.example",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".node-version",
    ".prettierignore",
    ".scratch",
    ".smoke-skip",
    ".tmp",
    ".vscode",
    "AGENTS.md",
    "DESIGN",
    "DESIGN.md",
    "README.md",
    "TESTING.md",
    "artifacts",
    "auth-email-template.html",
    "bin",
    "comparison-ui-design.png",
    "config",
    "docs",
    "eslint.config.mjs",
    "fonts",
    "messages",
    "next-env.d.ts",
    "next.config.ts",
    "onboarding-redesign-sample.png",
    "output",
    "package-lock.json",
    "package.json",
    "playwright.config.ts",
    "playwright.notif-error.config.ts",
    "playwright.notif.config.ts",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "postcss.config.mjs",
    "public",
    "scripts",
    "skills-lock.json",
    "src",
    "supabase",
    "tests",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "legacyOnlyRoots": [".scratch", ".tmp", "artifacts", "output"],
  "approvedProductionPaths": [
    "config/artifact-hygiene-policy.json",
    "scripts/ai-task.mjs",
    "scripts/check-artifact-hygiene.mjs",
    "scripts/check-github-owner-auth.mjs",
    "scripts/lib/ai-task-cleanup.mjs",
    "scripts/lib/ai-task-lifecycle-v2.mjs",
    "scripts/lib/artifact-manifest-v2.mjs",
    "scripts/lib/artifact-hygiene.mjs",
    "scripts/lib/github-owner-auth.mjs",
    "scripts/run-trusted-artifact-hygiene.mjs"
  ]
}
