# TALKPIK AI · environment variables example.
#
# Copy this file to `.env.local` for local development and fill in the real
# values from your Supabase project under Settings → API. Do NOT commit
# `.env.local`. See `docs/development/deployment.md` for the canonical
# variable list and visibility rules.

# --- Browser-visible (publishable) ----------------------------------------
# Base URL of the Supabase project (no path suffix — supabase-js appends).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable client key (browser-safe). Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Server-only (do NOT prefix with NEXT_PUBLIC_) ------------------------
# Server-only admin key. Leave unset until an admin-only server task
# requires it (Phase 6). Configure as a Vercel/CI secret, never in code.
# SUPABASE_SERVICE_ROLE_KEY=
