# TALKPIK AI · environment variables example.
#
# Copy this file to `.env.local` for local development and fill in the real
# values from your Supabase project under Settings → API. Do NOT commit
# `.env.local`. See README.md and this file for the canonical variable list
# and visibility rules.
#
# ============================================================================
# Environment separation (Local / Preview / Production)
# ============================================================================
#
# This file documents three Vercel environments, each with its own Supabase
# credentials:
#
#   Local       → .env.local on your machine (this file, copied + filled)
#   Preview     → Vercel project env vars, scope: Preview
#   Production  → Vercel project env vars, scope: Production
#
# Hard rule:
#   "Use separate Supabase projects or separate credentials for Preview and
#    Production when real user data exists."
#
# In practice that means:
#   - Production: dedicated Supabase project for real users. Keys NEVER in
#     any local file. Manage only via Vercel UI / CLI secrets.
#   - Preview / Local: a separate "talkpik-ai-dev" (or similar) Supabase
#     project. Test-user seeding + ad-hoc experiments target THIS project,
#     never production.
#
# Test-user seeding refuses to run when the target Supabase URL matches the
# production project — see SUPABASE_ENV_LABEL below. That guard prevents
# accidental test-user creation in production.

# ============================================================================
# Browser-visible (publishable) — same variable names across environments
# ============================================================================
#
# Each environment sets a DIFFERENT value for these. Vercel UI scopes them
# per-environment; `.env.local` holds the Local value only.

# Base URL of the Supabase project (no path suffix — supabase-js appends).
# Local/Preview: your dev/staging Supabase project URL
# Production:    your prod Supabase project URL (set in Vercel only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co

# Publishable client key (browser-safe). Never put a service-role / secret
# key here. Different value per environment.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Absolute site URL for Supabase auth redirects (emailRedirectTo).
# Local:      http://127.0.0.1:3000  (or your local dev URL)
# Preview:    https://<branch>-<project>.vercel.app
# Production: https://your-production-domain.example
# Required in non-development; redirect-url.ts throws if unset.
# In Next dev, browser-side auth redirects use the current local origin first
# so localhost/127.0.0.1 do not split the PKCE storage. Keep local testing on
# one origin whenever possible. Google OAuth builds its callback from the
# current browser origin. Google Client Secret is NOT configured here; keep it
# only in Supabase Dashboard or local Supabase secrets.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional GA4 web data stream measurement ID. Browser-visible and not a
# secret. Leave blank locally to disable Google Analytics event dispatch.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================================================
# Server-only (do NOT prefix with NEXT_PUBLIC_)
# ============================================================================

# Env label used as a safety guard by seeding and admin scripts.
# Test-user seeding only accepts known non-production labels:
# local | dev | development | test | testing | staging | preview | qa
#
# Scripts that seed test users refuse unknown labels and production labels.
# This prevents accidental test-user creation in the production Supabase
# project.
#
# Local:     local        (or dev if you share a hosted dev project)
# Preview:   preview      (Vercel sets the value via project config)
# Production: prod        (blocked by test-user seeding scripts)
#
# Keep this in plain text — it's a label, not a secret.
SUPABASE_ENV_LABEL=local

# Server-only admin key. Required for admin-only server tasks (Phase 6
# admin operations + test-user seeding).
#
# Prefer the new "Secret API key" (Supabase Dashboard → Project Settings →
# API → "Secret API Keys" → Generate). Format: `sb_secret_xxx...`.
# It can be revoked individually without rotating the JWT secret, unlike the
# legacy `service_role` JWT (`eyJ...`) which requires JWT secret regeneration
# to invalidate — Supabase explicitly recommends switching.
#
# Legacy `service_role` JWT format is still accepted by @supabase/supabase-js
# for backwards compatibility — if your project still uses that format you
# can paste it here, but the Dashboard warning is clear: "If leaked,
# generate a new JWT secret immediately. Prefer using Secret API keys
# instead." If you ever paste a service_role/Secret key into chat, email,
# or any shared transcript, regenerate it immediately and disable the
# leaked one.
#
# Different value per environment. NEVER share the prod key with dev/local.
# Never put this in browser-visible env vars or client code. Configure as
# a Vercel/CI secret only. `.env.local` is gitignored — values in this
# example file must remain placeholders.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Playwright setup creates or refreshes this learner account directly via
# Supabase Auth Admin before logging in. Use a dev/local account only.
E2E_STUDENT_EMAIL=student@example.test

# Dedicated e2e learner password. Preferred by tests/e2e/_setup/auth.setup.ts.
E2E_STUDENT_PASSWORD=REPLACE_ME_LONG_RANDOM_STRING

# Shared legacy test password fallback. Keep while older scripts still read it.
#
# REQUIRED ONLY in Local + Preview environments that seed test users.
# NEVER set this in Production env (test-user seeding should never run
# against prod).
SUPABASE_TEST_PASSWORD=REPLACE_ME_LONG_RANDOM_STRING

# Optional server-only TalkPik API base URL.
# When set, writing/evaluation uses:
#   POST /api/writing/submit
# and feedback polling syncs:
#   GET /api/evaluation/{submission_id}
#   GET /api/evaluation/{submission_id}/feedback
# Account deletion also uses this API server-side:
#   DELETE /api/auth/profile
# Do not prefix with NEXT_PUBLIC_; learner Supabase JWT is forwarded server-side.
TALKPIK_API_BASE_URL=
# Legacy deployments may still set TALKPIK_WRITING_API_BASE_URL; runtime reads both.
# TALKPIK_WRITING_API_BASE_URL=http://58.236.187.135:9009

# Optional SMTP transport for server-side notification email dispatch.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared secret required by POST /api/notifications/dispatch-email workers.
NOTIFICATION_WORKER_SECRET=

# ============================================================================
# Where each value lives (quick reference)
# ============================================================================
#
#                                | Local         | Preview          | Production
# -------------------------------+---------------+------------------+---------------
# .env.local                     | ✓ (real values)| —               | —
# Vercel env (Preview scope)     | —             | ✓                | —
# Vercel env (Production scope)  | —             | —                | ✓
# Test-user seeding allowed       | ✓             | ✓ (dev fixtures) | ✗ (blocked)
# SUPABASE_ENV_LABEL example     | local         | preview          | prod

# 관리자 계정. 검수용
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
