{
  "name": "talkpik-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-project-structure.mjs && node scripts/build-preflight.mjs --isolated-dev-build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:agent-skill-policy": "node scripts/check-agent-skill-policy.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "check:agent-skills": "node scripts/sync-agent-skills.mjs --check",
    "prepare:worktree-env": "node scripts/prepare-worktree-env.mjs",
    "check:project-structure": "node scripts/check-project-structure.mjs",
    "report:ui-contract": "node scripts/check-ui-contract.mjs --mode report",
    "check:ui-contract": "node scripts/check-ui-contract.mjs --mode diff-block",
    "check:worktree-lifecycle": "vitest run tests/scripts/worktree-lifecycle.test.mjs tests/scripts/report-worktree-lifecycle.test.mjs --maxWorkers=1",
    "report:worktree-lifecycle": "node scripts/report-worktree-lifecycle.mjs",
    "check:admin-boundary": "node scripts/check-admin-boundary.mjs",
    "check:notification-owner-read": "node scripts/check-notification-owner-read.mjs",
    "check:notification-transition-route": "node scripts/check-notification-transition-route.mjs",
    "backfill:comparison-blanks": "node scripts/backfill-comparison-blank-metrics.mjs",
    "harness:admin-boundary": "pnpm check:admin-boundary && pnpm check:notification-owner-read && pnpm check:notification-transition-route && pnpm vitest run tests/scripts/check-admin-boundary.test.mjs tests/scripts/check-notification-owner-read.test.mjs tests/scripts/check-notification-transition-route.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:supabase:local": "cross-env SUPABASE_LOCAL_STACK=1 E2E_ALLOW_DEV_DB_MUTATION=1 vitest run tests/integration/account-deletion-rpc.test.ts tests/integration/auth-completion-gate-rpc.test.ts tests/integration/institution-writing-exposure.test.ts tests/integration/pdf-export-quota-rpc.test.ts tests/integration/profile-trigger.test.ts tests/integration/rls-smoke.test.ts tests/integration/writing-submission-dedup.test.ts tests/integration/writing-submission-outbox-local.test.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.100.11",
    "antd": "^6.4.3",
    "country-flag-icons": "^1.6.17",
    "dayjs": "^1.11.20",
    "gsap": "^3.15.0",
    "iconsax-react": "^0.0.8",
    "lucide-react": "^1.22.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "nodemailer": "^9.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "recharts": "^3.8.1",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
